# Copie para .env.local (computador) e cadastre os mesmos nomes na Vercel
# (Project espaco35-loja > Settings > Environment Variables). Passo a passo: supabase/LEIA-ME.md
# NUNCA cole estas chaves em chat, print ou no código.

# --- Banco e painel (Supabase > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública: a "anon" (projetos antigos) ou a "sb_publishable_..." (projetos novos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-SECRETA

# --- Pagamento (Mercado Pago > Suas integrações > sua aplicação) ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=assinatura-secreta-do-webhook

# --- Frete para fora de Fortaleza (Melhor Envio > Integrações > Permissões de acesso) ---
MELHORENVIO_TOKEN=token-do-melhor-envio
LOJA_CEP_ORIGEM=60000000

# --- Aviso de pedido pago por e-mail (resend.com > API Keys) ---
RESEND_API_KEY=re_...
EMAIL_EQUIPE=voce@exemplo.com
# EMAIL_REMETENTE="Espaço 35 <pedidos@seudominio.com.br>"
